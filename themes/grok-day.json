{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#eeeeee",
    "--editor-surface": "#f5f5f5",
    "--foreground": "#262626",
    "--card": "#f5f5f5",
    "--card-foreground": "#262626",
    "--popover": "#f5f5f5",
    "--popover-foreground": "#262626",
    "--primary": "#2F64D2",
    "--primary-foreground": "#ffffff",
    "--secondary": "#dedede",
    "--secondary-foreground": "#262626",
    "--muted": "#dedede",
    "--muted-foreground": "#626262",
    "--accent": "#dedede",
    "--accent-foreground": "#262626",
    "--border": "#dedede",
    "--input": "#dedede",
    "--ring": "#2F64D2",
    "--chart-1": "#2F64D2",
    "--chart-2": "#378E23",
    "--chart-3": "#7D4BC6",
    "--chart-4": "#A27612",
    "--chart-5": "#CD3048",
    "--sidebar": "#f0f0f0",
    "--sidebar-foreground": "#444444",
    "--sidebar-primary": "#2F64D2",
    "--sidebar-primary-foreground": "#ffffff",
    "--sidebar-accent": "#dedede",
    "--sidebar-accent-foreground": "#262626",
    "--sidebar-border": "#dedede",
    "--sidebar-ring": "#2F64D2",
    "--worktree-sidebar": "#f0f0f0",
    "--worktree-sidebar-foreground": "#444444",
    "--worktree-sidebar-accent": "#dedede",
    "--worktree-sidebar-accent-foreground": "#262626",
    "--worktree-sidebar-border": "#dedede",
    "--worktree-sidebar-ring": "#2F64D2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767676",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#378E23"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#C3691E"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7D4BC6"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#0082AA"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#2F64D2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#0A8E70"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#262626"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#A27612"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#0C947C"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#CD3048"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A27612"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#2F64D2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#378E23"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#CD3048"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#0082AA"
      }
    }
  ]
}