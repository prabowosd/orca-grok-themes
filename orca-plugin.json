{
  "manifestVersion": 2,
  "execution": "data",
  "id": "grok-themes",
  "publisher": "prabowosd",
  "name": "Grok Themes",
  "version": "1.0.1",
  "description": "Grok Night and Grok Day app and terminal themes, using the GrokNight palette from xai-org/grok-build.",
  "repository": "https://github.com/prabowosd/orca-grok-themes",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "grok-night",
        "title": "Grok Night",
        "path": "themes/grok-night.json"
      },
      {
        "id": "grok-day",
        "title": "Grok Day",
        "path": "themes/grok-day.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "grok-night",
        "title": "Grok Night",
        "path": "terminal-themes/grok-night.json"
      },
      {
        "id": "grok-day",
        "title": "Grok Day",
        "path": "terminal-themes/grok-day.json"
      }
    ]
  }
}
